    <string name="section_auto_bypass">TỰ ĐỘNG VƯỢT RÀO &amp; ĐIỀU CHỈNH MẠNG</string>
    <string name="smart_vpn_title">Tự Động Vượt Rào Thông Minh</string>
    <string name="smart_vpn_desc">Tự động kết nối VPN khi khởi chạy game, sau đó ngắt về mạng ISP trực tiếp để đạt độ trễ thấp nhất.</string>
    <string name="stealth_headers_title">Stealth Headers &amp; Proxy Mesh</string>
    <string name="stealth_headers_desc">Tối ưu tiêu đề định tuyến và chống nghẽn mạng từ nhà mạng.</string>
    <string name="section_cellular_wifi">CHẤT LƯỢNG ĐỒ HỌA &amp; HIỆU NĂNG MÁY</string>
    <string name="section_graphics_quality">CHẤT LƯỢNG ĐỒ HỌA &amp; HIỆU NĂNG MÁY</string>
    <string name="graphics_quality_auto">Tự Động (Khuyên dùng)</string>
    <string name="graphics_quality_auto_desc">Tự tối ưu theo mạng &amp; giảm tải máy để giữ 60 FPS mượt mà.</string>
    <string name="graphics_quality_saver">Tiết Kiệm Dung Lượng (Thấp)</string>
    <string name="graphics_quality_saver_desc">Băng thông ~5M, siêu mát máy, tốn ít pin &amp; tiết kiệm đến 60% data di động.</string>
    <string name="graphics_quality_medium">Trung Bình</string>
    <string name="graphics_quality_medium_desc">Băng thông ~9M, cân bằng độ nét và nhiệt độ máy khi chơi lâu.</string>
    <string name="graphics_quality_high">Cao</string>
    <string name="graphics_quality_high_desc">Băng thông ~14M, hình ảnh 1080p sắc nét và chi tiết cao.</string>
    <string name="graphics_quality_ultra">Rất Cao (Tối Đa)</string>
    <string name="graphics_quality_ultra_desc">Băng thông ~20M, bung trọn đồ họa xCloud cao nhất cho máy mạnh.</string>
    <string name="cellular_mode_saver">Tiết Kiệm Dung Lượng (Thấp)</string>
    <string name="cellular_mode_saver_desc">Băng thông ~5M, siêu mát máy, tốn ít pin &amp; tiết kiệm data.</string>
    <string name="cellular_mode_max">Rất Cao (Tối Đa 20M)</string>
    <string name="cellular_mode_max_desc">Bung trọn vẹn 20 Mbps cho chất lượng đồ họa xCloud cao nhất.</string>
    <string name="wifi_speed_first">Tốc Độ #1 (Đồ Họa #2)</string>
    <string name="wifi_speed_first_desc">Ưu tiên độ trễ cực thấp thay vì đệm nhiều gói tin.</string>
