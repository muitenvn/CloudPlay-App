<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude sensitive WebView cookies, cache and session credentials from backup -->
    <exclude domain="root" path="app_webview" />
    <exclude domain="database" path="webview.db" />
    <exclude domain="database" path="webviewCookiesChromium.db" />
    <exclude domain="sharedpref" path="WebView" />
    <exclude domain="sharedpref" path="cloudplay_settings_store.xml" />
</full-backup-content>
