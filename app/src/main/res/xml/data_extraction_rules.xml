<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive WebView cookies, cache and session credentials from cloud backup -->
        <exclude domain="root" path="app_webview" />
        <exclude domain="database" path="webview.db" />
        <exclude domain="database" path="webviewCookiesChromium.db" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude sensitive WebView cookies from device transfer -->
        <exclude domain="root" path="app_webview" />
        <exclude domain="database" path="webview.db" />
        <exclude domain="database" path="webviewCookiesChromium.db" />
    </device-transfer>
</data-extraction-rules>
