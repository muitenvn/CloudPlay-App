{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and synced CloudPlay gaming preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique Firebase Auth UID of the user"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "photoUrl": {
          "type": "string",
          "description": "User profile avatar URL"
        },
        "preferredRegion": {
          "type": "string",
          "description": "Default server region: xcloud-japan, xcloud-korea, xcloud-us"
        },
        "directBypassEnabled": {
          "type": "boolean",
          "description": "Direct handshake bypass switch"
        },
        "streamQuality": {
          "type": "string",
          "description": "Target stream quality: 1080p, 720p"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document update server timestamp"
        }
      },
      "required": ["userId", "displayName", "email", "preferredRegion", "directBypassEnabled", "streamQuality", "createdAt"]
    },
    "CloudBookmark": {
      "title": "CloudBookmark",
      "description": "Cloud-synced Xbox Cloud Gaming bookmark or favorite game",
      "type": "object",
      "properties": {
        "bookmarkId": {
          "type": "string",
          "description": "Unique identifier for bookmark"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID owner of bookmark"
        },
        "title": {
          "type": "string",
          "description": "Title of the Xbox Cloud game"
        },
        "gameUrl": {
          "type": "string",
          "description": "Direct launch link for Xbox Cloud Gaming"
        },
        "imageUrl": {
          "type": "string",
          "description": "Cover art or thumbnail URL"
        },
        "region": {
          "type": "string",
          "description": "Preferred region for this game"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Document creation server timestamp"
        }
      },
      "required": ["bookmarkId", "userId", "title", "gameUrl", "region", "createdAt"]
    },
    "GameProfile": {
      "title": "GameProfile",
      "description": "Custom performance profile per game",
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "description": "Unique identifier for profile"
        },
        "userId": {
          "type": "string",
          "description": "Firebase Auth UID owner"
        },
        "gameTitle": {
          "type": "string",
          "description": "Title of the game"
        },
        "targetFps": {
          "type": "integer",
          "description": "Target streaming framerate: 30 or 60"
        },
        "bitrateMbps": {
          "type": "integer",
          "description": "Maximum bitrate bandwidth allocation"
        },
        "vibrationEnabled": {
          "type": "boolean",
          "description": "Haptic feedback toggle"
        },
        "lowLatencyAudio": {
          "type": "boolean",
          "description": "Low latency audio mode toggle"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last modified timestamp"
        }
      },
      "required": ["profileId", "userId", "gameTitle", "targetFps", "bitrateMbps", "vibrationEnabled", "lowLatencyAudio", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profile and synced settings document"
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": {
        "$ref": "#/entities/CloudBookmark"
      },
      "description": "User's saved game bookmarks"
    },
    "/users/{userId}/profiles/{profileId}": {
      "schema": {
        "$ref": "#/entities/GameProfile"
      },
      "description": "User's custom per-game streaming optimization profiles"
    }
  }
}
