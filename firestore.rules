rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             data.preferredRegion is string && data.preferredRegion.size() <= 50 &&
             data.directBypassEnabled is bool &&
             data.streamQuality is string && data.streamQuality.size() <= 20;
    }

    function isValidCloudBookmark(data) {
      return data.bookmarkId is string && data.bookmarkId.size() >= 1 && data.bookmarkId.size() <= 100 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.gameUrl is string && data.gameUrl.size() >= 1 && data.gameUrl.size() <= 1000 &&
             (!('imageUrl' in data) || data.imageUrl == null || (data.imageUrl is string && data.imageUrl.size() <= 1000)) &&
             data.region is string && data.region.size() <= 50;
    }

    function isValidGameProfile(data) {
      return data.profileId is string && data.profileId.size() >= 1 && data.profileId.size() <= 100 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.gameTitle is string && data.gameTitle.size() >= 1 && data.gameTitle.size() <= 200 &&
             data.targetFps is int && data.targetFps >= 30 && data.targetFps <= 120 &&
             data.bitrateMbps is int && data.bitrateMbps >= 1 && data.bitrateMbps <= 100 &&
             data.vibrationEnabled is bool &&
             data.lowLatencyAudio is bool;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'preferredRegion', 'directBypassEnabled', 'streamQuality', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'preferredRegion', 'directBypassEnabled', 'streamQuality', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'preferredRegion', 'directBypassEnabled', 'streamQuality', 'createdAt', 'updatedAt']) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                       isValidUserProfile(incoming());

      allow delete: if isOwner(userId);

      match /bookmarks/{bookmarkId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         incoming().keys().hasAll(['bookmarkId', 'userId', 'title', 'gameUrl', 'region', 'createdAt']) &&
                         incoming().keys().hasOnly(['bookmarkId', 'userId', 'title', 'gameUrl', 'imageUrl', 'region', 'createdAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidCloudBookmark(incoming());

        allow update: if isOwner(userId) &&
                         incoming().keys().hasOnly(['bookmarkId', 'userId', 'title', 'gameUrl', 'imageUrl', 'region', 'createdAt']) &&
                         incoming().bookmarkId == existing().bookmarkId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidCloudBookmark(incoming());

        allow delete: if isOwner(userId);
      }

      match /profiles/{profileId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         incoming().keys().hasAll(['profileId', 'userId', 'gameTitle', 'targetFps', 'bitrateMbps', 'vibrationEnabled', 'lowLatencyAudio', 'createdAt']) &&
                         incoming().keys().hasOnly(['profileId', 'userId', 'gameTitle', 'targetFps', 'bitrateMbps', 'vibrationEnabled', 'lowLatencyAudio', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                         isValidGameProfile(incoming());

        allow update: if isOwner(userId) &&
                         incoming().keys().hasOnly(['profileId', 'userId', 'gameTitle', 'targetFps', 'bitrateMbps', 'vibrationEnabled', 'lowLatencyAudio', 'createdAt', 'updatedAt']) &&
                         incoming().profileId == existing().profileId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         (!('updatedAt' in incoming()) || (incoming().updatedAt is timestamp && incoming().updatedAt <= request.time)) &&
                         isValidGameProfile(incoming());

        allow delete: if isOwner(userId);
      }
    }
  }
}
